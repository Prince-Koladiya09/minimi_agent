# Required for model responses and tool orchestration
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_MODEL=openai/gpt-oss-120b

# Required for the single model-visible web_search tool
TAVILY_API_KEY=

# Runtime
PORT=3000
DEFAULT_TZ=Asia/Kolkata
# Optional deterministic clock for temporal tests, e.g. 2026-11-11T12:00:00+05:30
NOW_OVERRIDE=
DB_PATH=./data/minimi.sqlite
